{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Agent App",
  "version": "0.1.0",
  "identifier": "com.pi.agent.app",
  "build": {
    "frontendDist": "startup"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pi Agent App",
        "width": 1280,
        "height": 860,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Pi Agent",
    "shortDescription": "Pi Agent App",
    "longDescription": "Windows desktop wrapper for Pi Web."
  }
}
